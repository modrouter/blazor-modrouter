<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<!-- Referencing ModRouter.AspNetCore brings the ASP.NET Core analyzers in; the probe components use computed sequence numbers on purpose. -->
		<NoWarn>$(NoWarn);ASP0006</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="bunit" Version="2.8.6" />
		<PackageReference Include="coverlet.collector" Version="10.0.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ModRouter\ModRouter.csproj" />
		<ProjectReference Include="..\ModRouter.AspNetCore\ModRouter.AspNetCore.csproj" />
		<!-- The typed-route generator, run against small compilations by TypedRouteGeneratorTests. -->
		<ProjectReference Include="..\ModRouter.Generators\ModRouter.Generators.csproj" />
		<!-- The compatibility Router tests: the pages it routes (an assembly whose every page is valid) and the "lazy"
		     assembly their OnNavigateAsync adds. -->
		<ProjectReference Include="..\ModRouter.Test.Fixtures\ModRouter.Test.Fixtures.csproj" />
		<ProjectReference Include="..\ModRouter.Sample.Extra\ModRouter.Sample.Extra.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>
</Project>
