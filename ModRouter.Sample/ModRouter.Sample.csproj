<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ModRouter\ModRouter.csproj" />
		<!-- Typed helpers (RouteNames, Get...Url, NavigateTo...Async) for the pages that carry [Route] and [RouteName]. -->
		<ProjectReference Include="..\ModRouter.Generators\ModRouter.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\ModRouter.Sample.Extra\ModRouter.Sample.Extra.csproj" />
	</ItemGroup>
	<!-- The Extra library is IsTrimmable and its pages are found by reflection only (?mode=pages), so the trimmed Release
	     publish must root it here. The trimming check publishes once as is and once with -p:RootExtra=false (after
	     cleaning obj/: ILLink is incremental and does not see the root as an input), when /extra is gone. -->
	<ItemGroup Condition="'$(RootExtra)' != 'false'">
		<TrimmerRootAssembly Include="ModRouter.Sample.Extra" />
	</ItemGroup>
</Project>
