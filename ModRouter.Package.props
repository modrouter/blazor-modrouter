<Project>
	<!-- NuGet metadata shared by the packable ModRouter projects (ModRouter and ModRouter.AspNetCore): one version for the pair, bumped
	     by hand as docs/versioning.md in ModRouter describes. -->
	<PropertyGroup>
		<Version>0.1.0-preview.1</Version>
		<Authors>Paul Van Gundy</Authors>
		<Copyright>Copyright (c) Paul Van Gundy</Copyright>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageTags>blazor;router;routing;aspnetcore;razor-components</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/modrouter/blazor-modrouter</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/modrouter/blazor-modrouter</PackageProjectUrl>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<PackageIcon>icon.png</PackageIcon>
		<!-- Embed the sources' locations in the symbol package, so a debugger can step into the library from GitHub. -->
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)docs-site\images\logo-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="all" />
	</ItemGroup>
</Project>
