<XRay Name="FleetList" Level="2">
    <h2>Fleet</h2>
    <ul class="ship-list">
        @foreach (var ship in Fleet.Ships)
        {
            <li>
                <RouteLink Route="ship" Parameters="@(new { id = ship.Id })" Class="ship-card">
                    <b>@ship.Name</b>
                    <span>@ship.Class, crew @ship.Crew</span>
                </RouteLink>
            </li>
        }
    </ul>
</XRay>
