<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<!-- The pages the compatibility Router tests route (AppAssembly must be an assembly whose every page is valid; the test
	     assembly holds deliberately invalid discovery fixtures, so it cannot be one). -->
	<ItemGroup>
		<ProjectReference Include="..\ModRouter\ModRouter.csproj" />
	</ItemGroup>
</Project>
