@implements IDisposable

@* The guide's window into the router. Read top to bottom it tells one story about the last navigation:
   the address, the route levels it matched, the stages it passed through, and the few navigations before it. *@
@* From lg up the log is always open and scrolls inside the guide. Below lg it is folded to its heading and summary until opened. *@
<section class="border-t border-stroke2 bg-background2 px-5 py-3 text-xs lg:max-h-[46vh] lg:overflow-y-auto" aria-label="What the router did">
    <div class="flex items-center justify-between gap-3">
        <h3 class="font-semibold text-foreground">What the router did</h3>
        <span class="flex items-center gap-3">
            <span class="tabular-nums font-medium @Summary.Class">@Summary.Text</span>
            <button type="button" class="crm-link lg:hidden" aria-expanded="@(Open ? "true" : "false")" aria-controls="router-log-body" @onclick="Toggle">@(Open ? "Hide" : "Show")</button>
        </span>
    </div>

    <div id="router-log-body" class="@(Open ? "" : "hidden") lg:block">
    @if (Last is null)
    {
        <p class="mt-2 text-foreground3">Waiting for the first navigation.</p>
    }
    else
    {
        <p class="code mt-1 truncate text-foreground2" title="@Last.Target">@Last.Target</p>

        <h4 class="mt-3 mb-1 font-semibold text-foreground3">1. Matched route</h4>
        <ol class="space-y-0.5" aria-label="Matched route levels">
            @if (State?.Chain is { } chain)
            {
                @for (var i = 0; i < chain.Matches.Count; i++)
                {
                    var level = chain.Matches[i];
                    <li class="flex flex-wrap items-baseline gap-x-1.5" style="padding-left:@(i * 0.75)rem">
                        <span class="text-foreground3" aria-hidden="true">@(i == 0 ? "" : "└")</span>
                        <span class="font-semibold text-foreground">@Describe(level)</span>
                        @if (!string.IsNullOrEmpty(level.Template) && level.Template != "/")
                        {
                            <span class="code text-foreground3">@level.Template</span>
                        }
                        @foreach (var value in level.Parameters.Values)
                        {
                            <span class="code rounded-medium bg-brandBackground/10 px-1 text-brandForeground">@value.Key = @value.Value</span>
                        }
                    </li>
                }
                @if (!string.IsNullOrEmpty(State.Query))
                {
                    <li class="code text-foreground3">query @State.Query</li>
                }
            }
            else if (State?.Failure is { } failure && failure != RouteFailure.None)
            {
                <li class="font-semibold text-statusDangerForeground">No route matched (@failure)</li>
            }
        </ol>

        <h4 class="mt-3 mb-1 font-semibold text-foreground3">2. Stages</h4>
        <ol class="ml-1 border-l border-stroke2" aria-label="Stages of the last navigation">
            @foreach (var step in Steps)
            {
                <li class="relative flex items-baseline gap-2 py-0.5 pl-3" title="@step.Hint">
                    <span class="absolute -left-[4.5px] top-[7px] h-2 w-2 rounded-circular @step.Dot"></span>
                    <span class="w-[4.75rem] shrink-0 font-medium @step.Text">@step.Name</span>
                    <span class="min-w-0 flex-1 truncate @(step.Note is null ? "text-foreground3" : step.Text)">@(step.Note ?? step.Hint)</span>
                    <span class="w-14 shrink-0 whitespace-nowrap text-right tabular-nums text-foreground3">@step.Ms</span>
                </li>
            }
        </ol>

        @if (Earlier.Count > 0)
        {
            <details class="mt-3">
            <summary class="cursor-pointer font-semibold text-foreground3">Before that</summary>
            <ul class="mt-1 space-y-0.5" aria-label="Earlier navigations">
                @foreach (var line in Earlier)
                {
                    <li class="flex gap-2"><span class="w-14 shrink-0 font-medium @line.Class">@line.Outcome</span><span class="code truncate text-foreground3">@line.Target</span></li>
                }
            </ul>
            </details>
        }
    }
    </div>
</section>
