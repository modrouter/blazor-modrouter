@* Where SignedInGuard sends a signed-out visitor. It reads returnUrl from the query string and goes back there after sign-in. *@
<div class="flex h-full items-center justify-center bg-backgroundMain p-6">
    <section class="w-full max-w-sm rounded-xlarge border border-stroke2 bg-background p-6 text-center shadow-card2">
        <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-large bg-brandBackground text-foregroundOnBrand" aria-hidden="true">
            <UiIcon Icon="@Icons.Outlined.LockClosed" />
        </span>
        <h1 class="mt-3 text-xl font-semibold text-foreground focus:outline-none" tabindex="-1">Sign in to Northwind CRM</h1>
        @if (!string.IsNullOrEmpty(ReturnUrl))
        {
            <p class="mt-1 text-sm text-foreground3">The guard sent you here from <span class="code rounded-small bg-background3 px-1.5 py-0.5">@ReturnUrl</span>. After you sign in, the router takes you back.</p>
        }
        <div class="mt-5 grid gap-2">
            <UiButton ButtonStyle="ButtonStyle.Primary" FullWidth="true" OnClick="() => SignIn(Role.Rep)">Continue as a sales rep</UiButton>
            <UiButton ButtonStyle="ButtonStyle.Outline" FullWidth="true" OnClick="() => SignIn(Role.Admin)">Continue as an admin</UiButton>
        </div>
    </section>
</div>
