@inherits LayoutComponentBase

@* The page around the demo. From lg up: the guide on one side, the CRM in a browser frame on the other, each scrolling on its own.
   Below lg the page is one column that scrolls as a whole: the guide on top, then the CRM at full width without the frame. *@
<div class="flex min-h-screen w-full flex-col bg-backgroundMain text-foreground lg:h-screen lg:flex-row lg:overflow-hidden">
    <aside class="shrink-0 border-b border-stroke2 bg-background lg:h-full lg:w-[25rem] lg:border-b-0 lg:border-r" aria-label="Guide">
        <GuidePanel />
    </aside>

    <div class="stage-wash relative flex flex-1 items-center justify-center lg:min-h-0 lg:p-6">
        <BrowserFrame>@Body</BrowserFrame>
    </div>
</div>

<UiDialogHost />
